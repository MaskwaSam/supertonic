{
  "name": "tts-onnx-web",
  "version": "1.0.0",
  "description": "TTS inference using ONNX Runtime for Web Browser",
  "type": "module",
  "scripts": {
    "assets:download": "node scripts/download-assets.mjs",
    "dev": "vite",
    "build": "vite build",
    "build:static": "VITE_SUPERTONIC_ASSET_BASE_URLS=https://huggingface.co/Supertone/supertonic-3/resolve/main,assets vite build && node scripts/copy-static-assets.mjs",
    "build:cdn": "VITE_SUPERTONIC_ASSET_BASE_URLS=https://huggingface.co/Supertone/supertonic-3/resolve/main vite build && node scripts/write-cdn-readme.mjs",
    "preview": "vite preview"
  },
  "keywords": ["tts", "onnx", "speech-synthesis", "web"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "fft.js": "^4.0.3",
    "onnxruntime-web": "^1.17.0"
  },
  "devDependencies": {
    "vite": "^5.0.0"
  }
}
